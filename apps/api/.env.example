HTTP_HOST=0.0.0.0
HTTP_PORT=3001
GRPC_PORT=5581
GRPC_TLS=false
GRPC_TLS_CA=../../deploy/certs/server/ca.crt
GRPC_TLS_CERT=../../deploy/certs/server/server.crt
GRPC_TLS_KEY=../../deploy/certs/server/server.key
GRPC_TLS_REQUIRE_CLIENT_CERT=false
GRPC_API_KEY=
DATABASE_KIND=postgres
DATABASE_URL=postgresql://oum:oum@localhost:5432/open_user_db
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# OpenID Connect (single sign-on). Off while OIDC_ISSUER is empty.
OIDC_ISSUER=https://oum.example.com/oidc
OIDC_COOKIE_KEYS=
OIDC_SIGNING_KEY_PATH=./oidc-signing-key.json

# Two-step verification. 32+ random characters.
TOTP_ENCRYPTION_KEY=

# Optional
TRUST_PROXY=
# OIDC_PKCE_OPTIONAL=true   # conformance suite only, never in production
